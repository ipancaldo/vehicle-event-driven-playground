@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-header__brand">
            <span class="app-header__mark" aria-hidden="true">AA</span>
            <span class="app-header__names">
                <span class="app-header__title">AutoAuctionPlayground</span>
                <span class="app-header__subtitle">Vehicle listing console</span>
            </span>
        </div>
        <span class="app-header__tag" title="Fictional domain used to practise event-driven architecture.">
            Fictional &middot; learning playground
        </span>
    </header>

    <main class="app-main">
        @Body
    </main>

    @* Docked at the bottom of the shell on every page, like a dev tools panel. *@
    <TechnicalConsole />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
